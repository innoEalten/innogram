generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model Profile {
  user_id         String          @id
  name            String          
  phone           String
  bio             String
  posts           Post[]

  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt @default(now())
}

model Post {
  id String @id @default(uuid())
  title String
  body String
  created_at DateTime @default(now())
  author_id String
  
  author Profile @relation(fields: [author_id], references: [user_id])
}
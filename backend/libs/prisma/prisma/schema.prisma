generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model Profile {
  userId String @id @map("user_id")
  name    String
  phone   String
  bio     String?
  posts   Post[]

  imageId String? @unique @map("image_id")
  image   Image?  @relation(fields: [imageId], references: [id])

  initiatedChats Chat[] @relation("ChatInitiator")
  receivedChats Chat[] @relation("ChatRecipient")
  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("profile")
}

model Post {
  id         String   @id @default(uuid())
  title      String
  body       String
  createdAt DateTime @default(now()) @map("created_at")
  authorId  String  @map("author_id") 

  images Image[]
  author Profile @relation(fields: [authorId], references: [userId])

  @@map("post")
  @@index([authorId], name: "idx_post_author_id")
  @@index([createdAt], name: "idx_post_created_at")
}

model File {
  id  String @id @default(uuid())
  url String

  image Image?
  fileOutbox FileOutbox[]

  @@map("file")
  @@index([id], name: "idx_file_id")
}

enum FileAction {
  MOVE_TO_PERMANENT_STORAGE
  DELETE_FROM_PERMANENT_STORAGE
}

model FileOutbox {
  id         String   @id @default(uuid())
  fileId     String   @map("file_id")
  action     FileAction
  targetPath String   @map("target_path")
  createdAt  DateTime @default(now()) @map("created_at")
  processed  Boolean  @default(false)

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_outbox")
}

model Image {
  id      String  @id @default(uuid())
  fileId String @unique @map("file_id")
  postId String? @map("post_id")

  profile Profile?
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("image")
  @@index([postId], name: "idx_image_post_id")
}

model Chat {
  id String @id @default(uuid())
  initiatorId String @map("initiator_id")
  recipientId String @map("recipient_id")

  initiator Profile @relation("ChatInitiator", fields: [initiatorId], references: [userId])
  recipient Profile @relation("ChatRecipient", fields: [recipientId], references: [userId])
  
  messages Message[]

  @@map("chats")
}

model Message {
  id String @id @default(uuid())
  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  
  chatId String @map("chat_id")
  senderId String @map("sender_id")
  
  chat Chat @relation(fields: [chatId], references: [id])
  sender Profile @relation(fields: [senderId], references: [userId])

  @@map("messages")
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model Profile {
  user_id              Int             @id
  name           String          
  phone        String
  bio    String

  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt @default(now())
}